# 虚拟环境
.venv/
venv/
env/

# Python 编译缓存
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# 打包产物
dist/
build/
*.egg-info/
*.spec

# 运行时数据（不提交用户上传的文件和输出）
data/input/
data/output/
data/workspace/
data/kb/

# 配置（含密钥，不提交）
configs/settings.yaml

# IDE / 编辑器
.vscode/
.idea/
*.suo
*.user

# OS
Thumbs.db
Desktop.ini
.DS_Store

# 日志
*.log

# 用户上传的文档（测试数据）
*.pdf
*.docx

# 模型缓存（sentence-transformers 等下载的模型）
.cache/
models/
